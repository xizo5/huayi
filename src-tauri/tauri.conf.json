{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Huayi",
  "version": "0.1.1",
  "identifier": "com.huayi.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "划译 · 生词本",
        "width": 900,
        "height": 660,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "focus": false,
        "theme": "Dark"
      },
      {
        "label": "popup",
        "url": "popup.html",
        "width": 400,
        "height": 470,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "shadow": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
